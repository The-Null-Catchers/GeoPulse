# Generate real values with python scripts/init-env.py. This file contains no credentials.
POSTGRES_PASSWORD=
JWT_SECRET=
SITE_ADDRESS=:80
CORS_ORIGINS=http://localhost
# Use false only for localhost HTTP; production must be true with HTTPS.
COOKIE_SECURE=false
ROUTING_URL=
SIMULATOR_EMAIL=
SIMULATOR_PASSWORD=
# Comma-separated exact HTTPS destination hosts; private IPs are always denied.
WEBHOOK_ALLOWED_HOSTS=
# Fernet key, generated automatically by init-env.py.
WEBHOOK_ENCRYPTION_KEY=

# Public browser tile configuration; rebuild web after changing. Use your own licensed provider for production.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors
